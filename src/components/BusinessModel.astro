---
import model from '../content/sections/model.json';
import LucideIcon from './LucideIcon.astro';
---
<section id="model" class="section">
  <div class="container">
    <div class="section-head">
      <span class="text-eyebrow">{model.eyebrow}</span>
      <h2 class="text-h2">{model.title}</h2>
      <p>{model.description}</p>
    </div>
    <div class="grid-bento">
      {model.cards.map((card) => (
        <div class="model-card card">
          <div class="icon-box"><LucideIcon name={card.icon} size="22" color="var(--text-secondary)" /></div>
          <h3 class="text-h3">{card.title}</h3>
          <p class="text-body">{card.body}</p>
        </div>
      ))}
    </div>
    <p class="model-honesty">{model.note}</p>
  </div>
</section>
