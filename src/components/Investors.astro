---
import inv from '../content/sections/investors.json';
---
<section id="investors" class="section" aria-label="Инвестиции в Polygram">
  <div class="container">
    <div class="section-head" style="text-align:left;">
      <span class="text-eyebrow" style="display:block;margin-bottom:8px;text-align:left;">{inv.eyebrow}</span>
      <h2 class="text-h2" style="text-align:left;margin-bottom:12px;">{inv.title}</h2>
      <p style="text-align:left;max-width:none;margin:0 0 24px 0;color:var(--text-secondary);">{inv.subtitle}</p>
    </div>
    <div class="invest-stats">
      {inv.stats.map((s) => (
        <div class="invest-stat">
          <span class="value text-metric">{s.value}</span>
          <span class="label">{s.label}</span>
        </div>
      ))}
    </div>
    <div class="hero-actions" style="justify-content:flex-start;gap:12px;flex-wrap:wrap;">
      <a href={inv.pitchDeckHref} class="btn-invest">
        <span>Получить pitch-deck</span>
      </a>
      <a href={`mailto:${inv.contactEmail}`} class="btn-demo">
        <span>{inv.contactEmail}</span>
      </a>
    </div>
    <p style="color:var(--text-secondary);font-size:0.95rem;margin-top:24px;">{inv.tractionNote}</p>
    <p style="color:var(--text-secondary);font-size:0.95rem;margin-top:8px;">{inv.teamNote}</p>

    <div class="invest-form">
      <h3 class="text-h3" style="margin-bottom:20px;text-align:left;">{inv.formHeading}</h3>
      <form id="investor-form" action="/api/investor-lead" method="POST" novalidate>
        <div class="form-field">
          <label for="invest-name">{inv.formNameLabel}</label>
          <input type="text" id="invest-name" name="name" required autocomplete="name" placeholder={inv.formNamePlaceholder} aria-required="true" />
          <span class="form-error" id="error-name">Введите имя и фамилию.</span>
        </div>
        <div class="form-field">
          <label for="invest-email">{inv.formEmailLabel}</label>
          <input type="email" id="invest-email" name="email" required autocomplete="email" placeholder={inv.formEmailPlaceholder} aria-required="true" />
          <span class="form-error" id="error-email">Введите корректный рабочий email.</span>
        </div>
        <div class="form-field">
          <label for="invest-intent">{inv.formAmountLabel}</label>
          <input type="number" id="invest-intent" name="amount" required min="10000" step="1000" placeholder={inv.formAmountPlaceholder} aria-required="true" />
          <span class="form-error" id="error-amount">Укажите сумму от $10 000.</span>
        </div>
        <button type="submit" class="btn-invest-block" id="invest-submit" disabled>{inv.formSubmit}</button>
      </form>
      <div class="form-success" id="invest-success" role="status" aria-live="polite">
        {inv.formSuccess}
      </div>
    </div>
  </div>
</section>
